# libFuzzer dictionary for semver-parser's `parse` target (semver version + range syntax).
# Tokens/operators the lexer/parser recognize — steers the fuzzer toward structured semver inputs.
caret="^"
tilde="~"
ge=">="
le="<="
gt=">"
lt="<"
eq="="
dot="."
dash="-"
plus="+"
star="*"
x_lower="x"
x_upper="X"
comma=","
or="||"
space=" "
v_prefix="v"
pre_alpha="-alpha"
pre_beta="-beta"
pre_rc="-rc"
pre_dot1=".1"
build="+build"
zeros="0.0.0"
basic="1.2.3"
caret_range="^1.0.0"
tilde_range="~1.2.0"
wildcard="1.x"
range_pair=">=1.2.3, <2.0.0"
prerelease="1.0.0-alpha.1"
build_meta="1.0.0+20130313144700"
